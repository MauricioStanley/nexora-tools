# ─────────────────────────────────────────────────────────────────────────────
# Nexora Tools — environment variables
# All variables are optional. Nothing here is required for local development.
# Only PUBLIC_* variables are exposed to the browser bundle — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin used for canonical URLs, hreflang, Open Graph and the sitemap.
# Default: https://tools.codywork.com — leave unset for production.
# PUBLIC_SITE_URL=https://tools.codywork.com

# Google Analytics 4 measurement ID. When empty, no analytics script is loaded at all.
# Analytics only loads in production builds and starts with Consent Mode "denied".
# PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification token (content of the meta tag only).
# Prefer DNS verification on Cloudflare; this exists as a fallback.
# PUBLIC_GSC_VERIFICATION=
