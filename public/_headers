# Cloudflare Pages / Workers static-assets headers. See DEPLOYMENT.md.
# The page-level Content-Security-Policy (script/style hashes) is emitted by Astro as a
# <meta> tag. `frame-ancestors` can't be set via <meta>, so it lives here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted build assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# PDF.js fonts/CMaps/WASM (versioned by the copy script; refreshed on dependency updates).
/vendor/*
  Cache-Control: public, max-age=2592000

/search-index/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=604800

# Preview deployments must never be indexed.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
