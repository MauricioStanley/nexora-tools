---
/**
 * Privacy indicator derived from the tool's declared execution mode — never from free text —
 * so no page can claim local processing unless the registry says the tool runs locally.
 */
import type { Locale } from '@/config/site';
import { getDictionary } from '@/i18n';
import type { ExecutionMode } from '@/tools/types';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  mode: ExecutionMode;
  locale: Locale;
  /** False for tools that take typed input instead of files (e.g. QR generator). */
  hasFiles?: boolean;
}

const { mode, locale, hasFiles = true } = Astro.props;
const copy = getDictionary(locale).privacy[mode];
const local = mode === 'client';
const detail = !hasFiles && 'detailNoFiles' in copy ? copy.detailNoFiles : copy.detail;
---

<p class:list={['privacy-badge', { 'privacy-badge--local': local }]}>
  <span class="privacy-badge__icon"><Icon name={local ? 'shield' : 'info'} /></span>
  <span class="privacy-badge__text">
    <strong>{copy.label}</strong>
    <span>{detail}</span>
  </span>
</p>

<style>
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .privacy-badge--local {
    border-color: var(--color-success-border);
    background: var(--color-success-soft);
  }

  .privacy-badge__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
  }

  .privacy-badge--local .privacy-badge__icon {
    background: color-mix(in srgb, var(--color-success) 16%, transparent);
    color: var(--color-success);
  }

  .privacy-badge__icon .icon {
    width: 1rem;
    height: 1rem;
  }

  .privacy-badge__text {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    color: var(--color-text-muted);
  }

  .privacy-badge__text strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
</style>
