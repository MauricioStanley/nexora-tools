---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ToolGrid from '@/components/discovery/ToolGrid.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Locale } from '@/config/site';
import { getCategories, getCategory } from '@/data/categories';
import { fmt, getDictionary, plural } from '@/i18n';
import { alternatesFor, pathFor } from '@/lib/routing';
import { buildPageSeo } from '@/lib/seo/meta';
import { breadcrumbSchema, collectionSchema } from '@/lib/seo/schema';
import { getToolsByCategory } from '@/tools/registry';

interface Props {
  categoryId: string;
  locale: Locale;
}

const { categoryId, locale } = Astro.props;
const t = getDictionary(locale);
const category = getCategory(categoryId);
const content = category.content[locale];
const key = { kind: 'category', categoryId } as const;
const path = pathFor(key, locale);
const tools = getToolsByCategory(categoryId);
const others = getCategories().filter((c) => c.id !== categoryId);
const heading = fmt(t.category.toolsIn, { category: content.name });

const seo = buildPageSeo({
  locale,
  title: content.seoTitle,
  description: content.seoDescription,
  path,
  alternates: alternatesFor(key),
});
const crumbs = [
  { name: t.nav.home, path: pathFor({ kind: 'home' }, locale) },
  { name: t.nav.tools, path: pathFor({ kind: 'tools' }, locale) },
  { name: content.name, path },
];
const schema = collectionSchema({
  name: heading,
  description: content.seoDescription,
  path,
  locale,
  items: tools.map((tool) => ({ name: tool.content[locale].name, path: pathFor({ kind: 'tool', toolId: tool.id }, locale) })),
});
---

<BaseLayout locale={locale} seo={seo} alternates={alternatesFor(key)} nav={{ section: 'category', categoryId }} jsonLd={[schema, breadcrumbSchema(crumbs)]}>
  <div class="container category" data-hue={category.hue}>
    <Breadcrumbs items={crumbs} locale={locale} />
    <header class="category__head">
      <span class="category__icon" aria-hidden="true"><Icon name={category.icon} /></span>
      <div>
        <h1>{heading}</h1>
        <p>{fmt(content.description)}</p>
        <span class="category__count">{plural(t.common.toolsCount, tools.length, locale)}</span>
      </div>
    </header>

    <ToolGrid tools={tools} locale={locale} headingLevel="h2" />

    <section class="category__others" aria-labelledby="others-title">
      <h2 id="others-title">{t.category.otherCategories}</h2>
      <ul role="list">
        {
          others.map((other) => (
            <li>
              <a href={pathFor({ kind: 'category', categoryId: other.id }, locale)} data-hue={other.hue}>
                <Icon name={other.icon} />
                {other.content[locale].name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={pathFor({ kind: 'tools' }, locale)}>
            <Icon name="layers" />
            {t.category.allTools}
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .category {
    --hue: var(--color-accent-text);
    padding-top: var(--space-4);
  }

  .category[data-hue='rose'] { --hue: var(--hue-rose); }
  .category[data-hue='violet'] { --hue: var(--hue-violet); }
  .category[data-hue='emerald'] { --hue: var(--hue-emerald); }

  .category__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    margin-block: var(--space-6) var(--space-10);
    max-width: 48rem;
  }

  .category__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--hue) 10%, var(--color-surface));
    color: var(--hue);
  }

  .category__icon .icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  .category__head h1 {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
  }

  .category__head p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .category__count {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .category__others {
    margin-top: var(--space-section);
  }

  .category__others h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .category__others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .category__others a {
    --hue: var(--color-accent-text);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .category__others a[data-hue='rose'] { --hue: var(--hue-rose); }
  .category__others a[data-hue='violet'] { --hue: var(--hue-violet); }
  .category__others a[data-hue='emerald'] { --hue: var(--hue-emerald); }

  .category__others a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
  }

  .category__others .icon {
    width: 1rem;
    height: 1rem;
    color: var(--hue);
  }
</style>
