---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBox from '@/components/discovery/SearchBox.astro';
import ToolGrid from '@/components/discovery/ToolGrid.astro';
import CategoryCard from '@/components/discovery/CategoryCard.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import Icon from '@/components/ui/Icon.astro';
import LogoMark from '@/components/ui/LogoMark.astro';
import { brand } from '@/config/brand';
import { featureFlags } from '@/config/features';
import type { Locale } from '@/config/site';
import { getCategories } from '@/data/categories';
import { fmt, getDictionary } from '@/i18n';
import { alternatesFor, pathFor } from '@/lib/routing';
import { buildPageSeo } from '@/lib/seo/meta';
import { websiteSchema } from '@/lib/seo/schema';
import { findTool, getPopularTools } from '@/tools/registry';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const key = { kind: 'home' } as const;
const seo = buildPageSeo({
  locale,
  title: t.meta.homeTitle,
  description: t.meta.homeDescription,
  path: pathFor(key, locale),
  alternates: alternatesFor(key),
  xDefaultPath: '/',
  rawTitle: true,
});
const popular = getPopularTools(6);
const categories = getCategories();
const toolsHref = pathFor({ kind: 'tools' }, locale);
const whyIcons = ['zap', 'shield', 'user-check', 'device'] as const;
const trustIcons = ['sparkle', 'user-check', 'lock'] as const;
const demoTool = findTool('merge-pdf');
const demoSizes = ['2.4 MB', '860 KB', '1.1 MB'];
---

<BaseLayout locale={locale} seo={seo} alternates={alternatesFor(key)} nav={{ section: 'home' }} jsonLd={[websiteSchema(locale, t.meta.homeDescription)]}>
  <section class="hero">
    <div class="hero__backdrop" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">
          <LogoMark id="hero" size={20} />
          {brand.productName}
        </p>
        <h1 class="hero__title">{t.home.title}</h1>
        <p class="hero__subtitle">{t.home.subtitle}</p>
        <div class="hero__search">
          <SearchBox locale={locale} id="hero-search" size="lg" />
        </div>
        <div class="hero__actions">
          <a class="btn btn--secondary" href={toolsHref} data-astro-prefetch>
            {t.home.ctaExplore}
            <Icon name="arrow-right" />
          </a>
          <ul class="hero__trust" role="list">
            {
              t.home.trust.map((item, i) => (
                <li>
                  <Icon name={trustIcons[i] ?? 'check'} />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="demo">
          <div class="demo__head">
            <span class="demo__app"><Icon name={demoTool?.icon ?? 'merge'} />{demoTool?.content[locale].name}</span>
            <span class="demo__badge"><Icon name="shield" />{t.privacy.client.label}</span>
          </div>
          <ul class="demo__files" role="list">
            {
              t.home.demoFiles.map((name, i) => (
                <li>
                  <span class="demo__file"><Icon name="file-pdf" />{name}</span>
                  <span class="tabular">{demoSizes[i]}</span>
                </li>
              ))
            }
          </ul>
          <div class="demo__progress"><span></span></div>
          <div class="demo__result">
            <span class="demo__check"><Icon name="check" /></span>
            <span class="demo__result-text">{t.home.demoResult} <span class="tabular">4.3 MB</span></span>
            <span class="demo__download"><Icon name="download" /></span>
          </div>
        </div>
        <div class="demo-flow">
          <span><Icon name="device" />{t.home.privacyFlowDevice}</span>
          <span class="demo-flow__line"></span>
          <span><Icon name="cloud-off" />{t.home.privacyFlowNoUpload}</span>
        </div>
      </div>
    </div>
  </section>

  {
    featureFlags.recentTools && (
      <section class="container recent" data-recent hidden data-index-url={`/search-index/${locale}.json`} aria-labelledby="recent-title">
        <h2 id="recent-title" class="recent__title">{t.home.recentTitle}</h2>
        <ul class="recent__list" role="list" data-recent-list />
      </section>
    )
  }

  <section class="section" aria-labelledby="popular-title">
    <div class="container">
      <div class="section-head">
        <h2 id="popular-title">{t.home.popularTitle}</h2>
        <p>{t.home.popularLead}</p>
      </div>
      <ToolGrid tools={popular} locale={locale} showCategory />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="categories-title">
    <div class="container">
      <div class="section-head">
        <h2 id="categories-title">{t.home.categoriesTitle}</h2>
        <p>{t.home.categoriesLead}</p>
      </div>
      <div class="categories">
        {categories.map((category) => <CategoryCard category={category} locale={locale} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="privacy-title">
    <div class="container">
      <div class="privacy">
        <div class="privacy__text">
          <p class="eyebrow">{t.home.privacyEyebrow}</p>
          <h2 id="privacy-title">{t.home.privacyTitle}</h2>
          <p class="privacy__lead">{t.home.privacyLead}</p>
          <ul class="privacy__points" role="list">
            {
              t.home.privacyPoints.map((point) => (
                <li>
                  <Icon name="check-circle" />
                  <div>
                    <h3>{point.title}</h3>
                    <p>{point.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="privacy__diagram" aria-hidden="true">
          <div class="flow">
            <div class="flow__node">
              <Icon name="file" />
              <span>{t.home.privacyFlowDevice}</span>
            </div>
            <div class="flow__edge"></div>
            <div class="flow__node flow__node--core">
              <Icon name="zap" />
              <span>{t.home.privacyFlowBrowser}</span>
            </div>
            <div class="flow__edge"></div>
            <div class="flow__node">
              <Icon name="download" />
              <span>{t.home.privacyFlowResult}</span>
            </div>
          </div>
          <div class="flow__cloud">
            <Icon name="cloud-off" />
            <span>{t.home.privacyFlowNoUpload}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <h2 id="why-title">{fmt(t.home.whyTitle)}</h2>
      </div>
      <ul class="why" role="list">
        {
          t.home.why.map((item, i) => (
            <li class="why__item">
              <span class="why__icon">
                <Icon name={whyIcons[i] ?? 'check'} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cta">
        <div class="cta__explore">
          <h2>{t.home.exploreTitle}</h2>
          <p>{t.home.exploreText}</p>
          <a class="btn btn--primary btn--lg" href={toolsHref}>
            {t.home.ctaExplore}
            <Icon name="arrow-right" />
          </a>
        </div>
        <div class="cta__company">
          <p class="eyebrow">{fmt(t.home.builtByEyebrow)}</p>
          <h2>{t.home.builtByTitle}</h2>
          <p>{fmt(t.home.builtByText)}</p>
          <a class="cta__link" href={brand.companyUrl} target="_blank" rel="noopener">
            {fmt(t.home.builtByCta)}
            <Icon name="external" />
            <span class="visually-hidden">{t.a11y.opensInNewTab}</span>
          </a>
        </div>
      </div>
      <AdSlot id="home-footer" />
    </div>
  </section>
</BaseLayout>

<script>
  import '@/scripts/recent-tools';
</script>

<style>
  .section--tight {
    padding-top: 0;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 78% 30%, var(--glow-accent-2) 0%, transparent 70%),
      radial-gradient(50% 60% at 20% 0%, var(--glow-accent) 0%, transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: auto, auto, 48px 48px, 48px 48px;
    mask-image: radial-gradient(90% 80% at 50% 20%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(90% 80% at 50% 20%, #000 40%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    min-width: 0;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: var(--text-sm);
  }

  .hero__title {
    max-width: 16ch;
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .hero__subtitle {
    max-width: 36rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .hero__search {
    max-width: 36rem;
    margin-top: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-5);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__trust .icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-text);
  }

  /* Illustrative product preview (decorative, aria-hidden). */
  .hero__visual {
    display: none;
  }

  .demo {
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    padding: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--color-surface-2), var(--color-surface));
    box-shadow: var(--shadow-lg), var(--highlight);
  }

  .demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .demo__app,
  .demo__badge,
  .demo__file {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .demo__app {
    font-weight: var(--weight-semibold);
  }

  .demo__app .icon {
    color: var(--hue-rose);
  }

  .demo__badge {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-success-border);
    border-radius: var(--radius-full);
    background: var(--color-success-soft);
    color: var(--color-success);
    font-size: var(--text-xs);
  }

  .demo__badge .icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .demo__files {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0;
  }

  .demo__files li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-inset);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .demo__file {
    color: var(--color-text);
  }

  .demo__file .icon {
    width: 1rem;
    height: 1rem;
    color: var(--hue-rose);
  }

  .demo__progress {
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-surface-3);
    overflow: hidden;
  }

  .demo__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .demo__progress span {
      animation: demo-progress 3.6s var(--ease-standard) infinite;
    }
  }

  @keyframes demo-progress {
    0% { transform: scaleX(0.05); }
    60%, 100% { transform: scaleX(1); }
  }

  .demo__result {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .demo__check {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-success);
    color: var(--color-text-inverse);
  }

  .demo__check .icon {
    width: 1rem;
    height: 1rem;
  }

  .demo__result-text {
    flex: 1;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
  }

  .demo__result-text span {
    margin-left: var(--space-2);
    color: var(--color-text-subtle);
    font-weight: var(--weight-regular);
  }

  .demo__download {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .demo-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .demo-flow > span:not(.demo-flow__line) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .demo-flow .icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  .demo-flow__line {
    width: 3rem;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--color-border-strong) 0 4px, transparent 4px 8px);
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .hero__visual {
      display: block;
    }
  }

  /* ── Recently used ────────────────────────────────────────── */
  .recent {
    margin-top: calc(var(--space-6) * -1);
    margin-bottom: var(--space-4);
  }

  .recent__title {
    margin-bottom: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .recent__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .recent__list :global(a) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .recent__list :global(a:hover) {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
  }

  .recent__list :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-text);
  }

  /* ── Categories ───────────────────────────────────────────── */
  .categories {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .categories {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── Privacy ──────────────────────────────────────────────── */
  .privacy {
    display: grid;
    gap: var(--space-10);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(60% 80% at 100% 0%, color-mix(in srgb, var(--color-success) 7%, transparent) 0%, transparent 70%),
      var(--color-surface);
  }

  .privacy__text h2 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tighter);
  }

  .privacy__lead {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .privacy__points {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .privacy__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  .privacy__points .icon {
    margin-top: 2px;
    color: var(--color-success);
  }

  .privacy__points h3 {
    font-size: var(--text-base);
  }

  .privacy__points p {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .privacy__diagram {
    display: grid;
    align-content: center;
    gap: var(--space-6);
  }

  .flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
  }

  .flow__node {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .flow__node .icon {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--color-text);
  }

  .flow__node--core {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
  }

  .flow__node--core .icon {
    color: var(--color-accent-text);
  }

  .flow__edge {
    width: clamp(0.75rem, 3vw, 2.5rem);
    height: 2px;
    background: linear-gradient(90deg, var(--color-border-strong), var(--color-accent-border));
  }

  .flow__cloud {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  @media (min-width: 1024px) {
    .privacy {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  /* ── Why ──────────────────────────────────────────────────── */
  .why {
    display: grid;
    gap: var(--space-3);
  }

  .why__item {
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .why__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .why__item h3 {
    font-size: var(--text-lg);
  }

  .why__item p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .why {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ── CTA ──────────────────────────────────────────────────── */
  .cta {
    display: grid;
    gap: var(--space-4);
  }

  .cta__explore,
  .cta__company {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .cta__explore {
    background:
      radial-gradient(70% 90% at 0% 0%, var(--glow-accent) 0%, transparent 70%),
      var(--color-surface);
  }

  .cta__company {
    background: var(--color-bg-subtle);
  }

  .cta h2 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .cta p:not(.eyebrow) {
    color: var(--color-text-muted);
  }

  .cta__explore .btn {
    margin-top: var(--space-3);
  }

  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: var(--weight-medium);
  }

  .cta__link .icon {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 900px) {
    .cta {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
