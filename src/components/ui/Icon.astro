---
import type { HTMLAttributes } from 'astro/types';
import { icons, type IconName } from '@/lib/icons';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible label. Omit for decorative icons (default). */
  label?: string;
  strokeWidth?: number;
}

// `...rest` carries Astro's scoped-style attribute so parents can style the icon.
const { name, size, class: className, label, strokeWidth = 1.75, ...rest } = Astro.props;
const paths = icons[name];
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...rest}
>
  {paths.map((d) => <path d={d} />)}
</svg>
