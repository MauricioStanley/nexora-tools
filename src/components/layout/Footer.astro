---
import { brand } from '@/config/brand';
import type { Locale } from '@/config/site';
import { getCategories } from '@/data/categories';
import { fmt, getDictionary } from '@/i18n';
import { pathFor } from '@/lib/routing';
import { getToolsByCategory } from '@/tools/registry';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string> | null;
}

const { locale, alternates } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const groups = getCategories().map((category) => ({ category, tools: getToolsByCategory(category.id) }));
---

<footer class="site-footer" id="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo locale={locale} id="footer" />
        <p class="site-footer__tagline">{t.footer.tagline}</p>
        <p class="site-footer__note">
          <Icon name="shield" />
          <span>{t.footer.localNote}</span>
        </p>
      </div>

      <nav class="site-footer__nav" aria-label={t.a11y.footerNav}>
        {
          groups.map(({ category, tools }) => (
            <div class="site-footer__col">
              <h2 class="site-footer__heading">
                <a href={pathFor({ kind: 'category', categoryId: category.id }, locale)}>{category.content[locale].shortName}</a>
              </h2>
              <ul role="list">
                {tools.map((tool) => (
                  <li>
                    <a href={pathFor({ kind: 'tool', toolId: tool.id }, locale)}>{tool.content[locale].name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="site-footer__col">
          <h2 class="site-footer__heading">{t.footer.company}</h2>
          <ul role="list">
            <li><a href={pathFor({ kind: 'tools' }, locale)}>{t.nav.allTools}</a></li>
            <li><a href={pathFor({ kind: 'page', pageId: 'about' }, locale)}>{t.footer.about}</a></li>
            <li><a href={pathFor({ kind: 'page', pageId: 'contact' }, locale)}>{t.footer.contact}</a></li>
            <li><a href={pathFor({ kind: 'page', pageId: 'privacy' }, locale)}>{t.footer.privacy}</a></li>
            <li><a href={pathFor({ kind: 'page', pageId: 'terms' }, locale)}>{t.footer.terms}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__product">
        {fmt(t.footer.productOf)}
        <a href={brand.companyUrl} rel="noopener" target="_blank">
          {fmt(t.footer.visitCompany)}
          <Icon name="external" />
          <span class="visually-hidden">{t.a11y.opensInNewTab}</span>
        </a>
      </p>
      <LanguageSwitcher locale={locale} alternates={alternates} variant="list" />
      <p class="site-footer__legal">{fmt(t.footer.rights, { year, company: brand.legalName })}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-bg-subtle);
    padding-block: var(--space-16) var(--space-10);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-10);
  }

  .site-footer__brand {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    max-width: 22rem;
  }

  .site-footer__tagline {
    color: var(--color-text-muted);
  }

  .site-footer__note {
    display: flex;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .site-footer__note .icon {
    color: var(--color-success);
    width: 1rem;
    height: 1rem;
    margin-top: 1px;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .site-footer__heading a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-1);
  }

  .site-footer__col li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--color-text);
  }

  .site-footer__bottom {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-subtle);
  }

  .site-footer__product a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-1);
    color: var(--color-text-muted);
  }

  .site-footer__product .icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  @media (min-width: 768px) {
    .site-footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .site-footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: minmax(16rem, 1fr) 2.4fr;
    }
  }
</style>
